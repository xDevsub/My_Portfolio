{
  "buildCommand": "cd frontend_react && npm install && npm run build",
  "outputDirectory": "frontend_react/build",
  "devCommand": "cd frontend_react && npm start",
  "installCommand": "cd frontend_react && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
